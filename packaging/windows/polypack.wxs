<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="PolyPack CLI" Language="1033"
           Version="$(var.Version)" Manufacturer="Erik"
           UpgradeCode="{6D7E0E5A-2C7B-4E1B-9F3A-8B6D5C4E2A11}">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer PolyPack CLI is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="PaxIcon" SourceFile="$(var.IconDir)\pax.ico" />
    <Property Id="ARPPRODUCTICON" Value="PaxIcon" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="polypack">
          <Component Id="PolyExe" Guid="*" Win64="yes">
            <File Id="PolyExe" Source="$(var.SourceDir)\polypack.exe" KeyPath="yes" />
            <Environment Id="PathEnv" Name="PATH" Value="[INSTALLDIR]" Permanent="no"
                         Part="last" Action="set" System="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="MainFeature" Title="PolyPack CLI" Level="1">
      <ComponentRef Id="PolyExe" />
    </Feature>
  </Product>
</Wix>
