{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PolyUpdaterSample",
  "version": "0.1.0",
  "mainBinaryName": "polypack-updater-sample",
  "identifier": "com.polypack.updater-drill",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "Polypack Updater Sample",
        "width": 420,
        "height": 260,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
